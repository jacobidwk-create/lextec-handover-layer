# Copy to .env and fill in, or export these variables in your shell.
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
# Optional: address of a local model server that speaks the same protocol
LLM_BASE_URL=
# Optional: seconds after which a model call that does not answer is given up (default 60)
LLM_TIMEOUT_SECONDS=
# Optional: send briefings by e-mail in addition to the outbox folder
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
BRIEFING_TO=
BRIEFING_FROM=
# Optional: language of the briefing for the legal team, de (default) or en
BRIEFING_LANGUAGE=
